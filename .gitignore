# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
build/*
.cache
_ai_tmp
build_x64
OpenCV455_MSVC32/
# Halcon 17 SDK（lib/dll/头，随 Halcon 安装，体积大，不入库）
HalconDemo/Halcon17/
HalconDemo/*.exe
HalconDemo/*.obj
HalconDemo/*.ilk
HalconDemo/*.pdb
HalconDemo/Debug/
HalconDemo/Release/
HalconDemo/x64/
HalconDemo/x86/
HalconDemo/*.shm
HalconDemo/*.ncm
# Halcon GUI Demo 运行日志（运行期落盘，用于对比记录）
HalconGUIDemo.log
HalconDemo/*.log
# ImGui 运行期窗口布局（每个用户自己生成，不入库）
imgui.ini
release_GeoGUIDemo_x64

# 私密凭据：绝不能进仓库
Gitee私人令牌.txt
Gitee私人令牌.txt.txt
*令牌*.txt
*令牌*.txt.txt

# SDK build outputs
_sdk64
_sdk64dll
_sdk32
build_dll64
build_x86
# Visual Studio 生成器的输出目录（cmake -G "Visual Studio 16 2019" ... -B build_vs）
build_vs

# 本机加密软件产生的图片/文件密文备份（原名后追加 .txt，仅本地使用，见 .clinerules）
*.png.txt
*.jpg.txt
*.jpeg.txt
*.bmp.txt
*.tif.txt
*.tiff.txt
*.ico.txt

# 匹配模型序列化产物：形状模型 .shm，NCC 模型 .ncm（运行时生成，可由模板重建）
*.shm
*.ncm

# CLI / Demo 匹配结果输出目录
out/

# 外部标准数据集（体积大，可重新采集，整包不入库）
# 只保留抽样目录 dataset/sample/（约 5 MB），clone 后能立刻跑测试
dataset/*
!dataset/sample/
# Halcon 经典示例图（螺母/卡簧/齿轮/圆环/logo，20 张约 11 MB），用于形状匹配多实例测试
!dataset/image/

# 本机明文加密包约定扩展名（.zip/.7z 落盘即密文，详见 .clinerules）
*.zip1
*.7z1

# 大数据样例集：case2/case3 体积大，改走网盘同步，不入库
# （case1 已入库，约 5 MB，保留以便 clone 后立即可跑）
case2/
case3/

# GUI「复现留痕」目录：运行期落盘 logs/<app>_<时间>/{log.txt, template*.png, target, result}
# 每次启动新建一个，含数百 KB 截图，属于运行产物，不入库（详见 docs 与 .clinerules）
logs/

